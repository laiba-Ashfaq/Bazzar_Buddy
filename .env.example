# ─── Copy this to .env and fill in your values ───────────────────────────────
# Get your Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Run: curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# Pick a Flash model that lists "generateContent" in supportedGenerationMethods
# Usually: gemini-1.5-flash or gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Ollama local vision model (optional; install with: ollama pull llava:7b)
OLLAMA_MODEL=llava:7b
# not required for image extraction.
OLLAMA_TEXT_MODEL=gemma3:1b
OLLAMA_URL=http://localhost:11434

# Set to 1 to use cached responses during demo (no internet needed)
DEMO_MODE=0

# CORS origin for the React frontend
FRONTEND_URL=http://localhost:5173
